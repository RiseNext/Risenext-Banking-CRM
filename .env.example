# ---- Server ----
NODE_ENV=development
PORT=8080

# ---- Database (Neon) ----
# Use the POOLED connection string from Neon for the app.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# Use the DIRECT (non-pooled) string for migrations.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require

# ---- Auth ----
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-min-32-chars-xxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=replace-me-min-32-chars-yyyyyyyyyyyyyyyy
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_DOMAIN=

# ---- CORS ----
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ---- Bootstrap super admin (first boot only) ----
BOOTSTRAP_SUPERADMIN_EMAIL=admin@risenext.com
BOOTSTRAP_SUPERADMIN_PASSWORD=

# ---- Policy ----
RECYCLE_BIN_RETENTION_DAYS=30
MAX_UPLOAD_MB=10

# ---- Frontend (frontend/.env.local) ----
NEXT_PUBLIC_API_URL="https://<your-service>.up.railway.app"
